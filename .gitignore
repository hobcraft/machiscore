# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# データ取得バッチ（Python）
# e-Stat の appId が入るため絶対にコミットしない
scripts/.env
scripts/venv/
__pycache__/

# バッチの中間生成物。バッチを回せば再生成できるので追跡しない。
# アプリが実際に使うのは assets/data/machiscore.json（こちらは追跡する）。
/data/
